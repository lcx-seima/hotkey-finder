        "th" : { "stringUnit" : { "state" : "translated", "value" : "ตามภาษาของระบบ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跟随系统" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "依照系統設定" } }
      }
    },
    "Forward Delete" : {
      "comment" : "A keyboard key label.",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "前方削除" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบไปข้างหน้า" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "向前删除" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "向前刪除" } }
      }
    },
    "Help" : {
      "comment" : "A keyboard key label, not the Help menu.",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ヘルプ" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "วิธีใช้" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "帮助" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "輔助說明" } }
      }
    },
    "Helps identify apps like Alfred that do not become active. Hotkey Finder only compares window metadata such as identifiers, owning processes, and sizes. It never captures or saves your screen." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Alfred のようにアクティブにならないアプリを特定するために使用します。Hotkey Finder が参照するのは、ウインドウ識別子、所有プロセス、サイズなどのメタデータだけです。画面を撮影したり保存したりすることはありません。" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "ช่วยระบุแอปอย่าง Alfred ที่ไม่แสดงเป็นแอปที่ใช้งานอยู่ Hotkey Finder จะเปรียบเทียบเฉพาะข้อมูลหน้าต่าง เช่น รหัส โปรเซสเจ้าของ และขนาด โดยจะไม่จับภาพหรือบันทึกหน้าจอของคุณ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于识别 Alfred 这类不会激活自身的 App。Hotkey Finder 只比较窗口编号、所属进程和尺寸等元数据，不会截取或保存屏幕画面。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用來識別 Alfred 這類不會主動啟用的 App。Hotkey Finder 只會比較視窗識別碼、所屬程序和大小等中繼資料，不會擷取或儲存螢幕畫面。" } }
      }
    },
    "Home" : {
      "comment" : "A keyboard key label.",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホーム" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "Home" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Home" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Home" } }
      }
    },
    "Hotkey Finder" : {
      "shouldTranslate" : false
    },
    "Hotkey Finder couldn’t restart automatically. Quit and reopen the app to apply the language change." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder を自動的に再起動できませんでした。アプリを終了してもう一度開くと、言語の変更が反映されます。" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder ไม่สามารถเปิดใหม่โดยอัตโนมัติได้ โปรดออกจากแอปแล้วเปิดอีกครั้งเพื่อใช้ภาษาที่เลือก" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder 无法自动重启。请退出并重新打开 App，以应用语言更改。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder 無法自動重新啟動。請結束並重新開啟 App，以套用語言變更。" } }
      }
    },
    "Hotkey Finder reads keyboard events only while its window is in front so it can identify which app receives a shortcut. It never changes or blocks your keystrokes." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder は、ウインドウが前面にある間だけキー入力イベントを読み取り、ショートカットを受け取ったアプリを特定します。キー入力を変更したりブロックしたりすることはありません。" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder จะอ่านอีเวนต์จากแป้นพิมพ์เฉพาะตอนที่หน้าต่างอยู่ด้านหน้า เพื่อระบุว่าแอปใดได้รับปุ่มลัด โดยจะไม่แก้ไขหรือบล็อกการกดแป้นของคุณ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder 仅在窗口位于前台时读取键盘事件，用于判断哪个 App 收到了快捷键。它不会修改或拦截你的按键。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder 只會在視窗位於最前方時讀取鍵盤事件，用來判斷哪個 App 收到快速鍵。它不會修改或攔截你的按鍵。" } }
      }
    },
    "Input Monitoring Access Required" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "入力監視の許可が必要です" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "ต้องอนุญาตการตรวจสอบอินพุต" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要输入监控权限" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要輸入監控權限" } }
      }
    },
    "Keep this window in front, then press the shortcut you want to inspect." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このウインドウを前面に表示したまま、調べたいショートカットを押してください。" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "วางหน้าต่างนี้ไว้ด้านหน้า แล้วกดปุ่มลัดที่ต้องการตรวจสอบ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保持此窗口在前台，然后按下要检查的快捷键。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將此視窗保持在最前方，然後按下想要檢查的快速鍵。" } }
      }
    },
    "KeyCode %d" : {
      "comment" : "Fallback keyboard key label. %d is the numeric hardware key code.",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キーコード %d" } },
