      }
    },
    "Detection results appear here, newest first." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しい検出結果から順にここに表示されます。" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "ผลการตรวจจับล่าสุดจะแสดงที่นี่ก่อน" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "侦测结果会按时间倒序显示在这里。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偵測結果會依時間由新到舊顯示在這裡。" } }
      }
    },
    "Enable Window Detection (Optional)" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウインドウ検出を有効にする（任意）" } },
