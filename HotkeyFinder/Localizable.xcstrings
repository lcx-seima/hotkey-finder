{
  "sourceLanguage" : "en",
  "strings" : {
    "Allow Input Monitoring" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "入力監視を許可" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "อนุญาตการตรวจสอบอินพุต" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许输入监控" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "允許輸入監控" } }
      }
    },
    "Allow Screen Recording" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "画面収録を許可" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "อนุญาตการบันทึกหน้าจอ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许屏幕录制" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "允許螢幕錄製" } }
      }
    },
    "App Activation" : {
      "comment" : "Detection method: the target was inferred because an app became active after the shortcut.",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリのアクティブ化" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "การเปิดใช้งานแอป" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "App 激活" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 啟用" } }
      }
    },
    "Checking Permissions" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "権限を確認中" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังตรวจสอบสิทธิ์" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查权限" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查權限" } }
      }
    },
    "Choose the language Hotkey Finder uses." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Hotkey Finder で使用する言語を選択します。" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "เลือกภาษาที่ต้องการใช้ใน Hotkey Finder" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择 Hotkey Finder 使用的语言。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇 Hotkey Finder 使用的語言。" } }
      }
    },
    "Clear History" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "履歴を消去" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "ล้างประวัติ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空记录" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清除記錄" } }
      }
    },
    "Couldn’t Restart" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再起動できませんでした" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดแอปใหม่ไม่ได้" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法重启" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法重新啟動" } }
      }
    },
    "Couldn’t start keyboard monitoring. Make sure Input Monitoring access is enabled, then try again or restart the app." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キー入力の監視を開始できませんでした。入力監視が許可されていることを確認してから、もう一度試すかアプリを再起動してください。" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "เริ่มตรวจสอบแป้นพิมพ์ไม่ได้ โปรดตรวจสอบว่าอนุญาตการตรวจสอบอินพุตแล้ว จากนั้นลองอีกครั้งหรือเปิดแอปใหม่" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法启动键盘监控。请确认已允许输入监控，然后重试或重新启动 App。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法啟動鍵盤監控。請確認已允許輸入監控，然後再試一次或重新啟動 App。" } }
      }
    },
    "Current Result" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在の結果" } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "ผลลัพธ์ปัจจุบัน" } },
